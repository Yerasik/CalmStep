# Copy to .env on the Mac. Do not commit .env.
# On iPhone / iPad, API_BASE_URL must be the Mac LAN IP, not localhost.

API_BASE_URL=http://10.21.36.11:8081

# Ollama on the Mac (OpenAI-compatible). LLM_API_KEY can be empty for local Ollama.
# If Ollama is down, FastAPI returns interview fixtures and a template plan.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:70b
LLM_TIMEOUT_S=180
IF_LLM_DOWN=fixtures
